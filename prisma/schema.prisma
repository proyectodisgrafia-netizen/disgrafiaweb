generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  email     String   @unique
  name      String?
  role      String   @default("docente")
  createdAt DateTime @default(now())
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  dob       DateTime?
  createdAt DateTime @default(now())
}
